; C library functions that compiled game code and the runtime may call on the Windows Simulator.
; The build turns this into an import library for ucrtbase.dll (part of Windows 10 and later), so
; linking pdex.dll needs only LLVM (clang + lld-link), not the Visual Studio C runtime libraries.
; Only the functions a game actually references are imported.
LIBRARY ucrtbase.dll
EXPORTS
    memcmp
    memcpy
    memmove
    memset
    strlen
    acos
    acosf
    acosh
    acoshf
    asin
    asinf
    asinh
    asinhf
    atan
    atanf
    atan2
    atan2f
    atanh
    atanhf
    cbrt
    cbrtf
    ceil
    ceilf
    cos
    cosf
    cosh
    coshf
    exp
    expf
    exp2
    exp2f
    floor
    floorf
    fma
    fmaf
    fmod
    fmodf
    ilogb
    ilogbf
    log
    logf
    log2
    log2f
    log10
    log10f
    modf
    modff
    pow
    powf
    round
    roundf
    scalbn
    scalbnf
    sin
    sinf
    sinh
    sinhf
    sqrt
    sqrtf
    tan
    tanf
    tanh
    tanhf
    trunc
    truncf
