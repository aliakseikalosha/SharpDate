<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SharpDate: C# bindings for the Playdate C API.
    Compiled against SharpDate.CoreLib so the same assembly runs in the Simulator and on the device.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SharpDate</AssemblyName>
    <RootNamespace>Playdate</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every public member is documented (CS1591 stays on); only non-obvious parameters get a <param> tag (CS1573). -->
    <NoWarn>$(NoWarn);CS1573;CS8500</NoWarn>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../build/SharpDate.CoreLib.props" />

</Project>
